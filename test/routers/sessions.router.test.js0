import UserManagerdb from "../../src/usuarioManagerDBHelper.js";
import { expect } from "chai";
import {afterEach, before, describe, it} from "mocha";
import supertest from "supertest";

const requester = supertest("http://localhost:8080"); 

//describe(): Define un entorno de test | 
describe("", function(){
    this.timeout(10000); //tiempo default para evirar errores por timeout cuando usamos BBDD en los test

    //Test Session:
    describe("##### Test: Router Session #######", function(){
        //before(): acciones que queremos que se ejecuten antes del test en sí
        before(async function(){
            this.userManager = new UserManagerdb();
        });
    
        //Accciones que se ejecutan cuando se termina de ejecutar el entorno de test:
        /*
        after(async function(){
            //hago esto acá para "matar" la terminal cuando termina el entorno de test porque el flag --test me tira el error: unknown option '--exit'
            process.exit();
        });

        afterEach(async function(){
        
        });
        */
    
        //it(descricionDeLaprueba, funcionQueEjecutaLaprueba): Es el componente que hace la prueba en concreto
        it("Valida que la ruta: /api/sessions/login, método post, no retorne datos sensibles", async function(){
            let { body } = await requester.post("/api/sessions/login").send({"email": "adminCoder@coder.com", "password": "adminCod3r123"});

            console.log("response: ", body._usuario)
            //Afirmaciones: 
            expect(body._usuario.hasOwnProperty('password')).to.be.equal(false);
        });


        it("Valida que la ruta: /api/sessions/login, método post, cree correctamente una cookie de usuario", async function(){
            let { headers } = await requester.post("/api/sessions/login").send({"email": "adminCoder@coder.com", "password": "adminCod3r123"});

            //Afirmaciones: 
            expect(headers["set-cookie"][0].includes("Access_Cookie")).to.equal(true);
            expect(headers["set-cookie"][0] !== "").to.equal(true);
        });

        it("Valida que la ruta: /api/sessions/logout, método get, destruya correctamente la cookie de sesion", async function(){
            let { headers } = await requester.get("/api/sessions/logout");
            
            //Afirmaciones: 
            expect(headers["set-cookie"][0].includes("Expires=Thu")).to.equal(true);
        });
    })
});