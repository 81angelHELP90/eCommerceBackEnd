{{>navBar}}
{{>message}}
<main class="flex-container">
    <section class="col-10 flex-container">
        <div class="card my-5 mx-1">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Usuario: {{ usuario.nombre }}</h3>
                <h5 class="card-title text-center mb-2">Datos usuario:</h5>
                <p class="text-center mb-1">Nombre: <strong>{{ usuario.nombre }}</strong></p>
                <p class="text-center mb-1">Rol: <strong>{{ usuario.rol }}</strong></p>
                <p class="text-center mb-1">Correo electrónico: <strong>{{ usuario.email }}</strong></p>
            </div>
        </div>
    </section>
</main>