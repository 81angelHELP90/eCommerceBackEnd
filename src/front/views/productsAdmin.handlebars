{{>navBar}}
<div>
    <header class="flex-container">
        <div class="col-8 item">
            <h1 class="my-2 mb-3 text-center">Lista de Productos:</h1>
        </div>
    </header>
    <main class="flex-container principal">
        <section class="col-10 flex-container">
            {{#each products}}
            <div class="card my-1 mx-1 ">
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">{{title}}</h5>
                    <p>Descripcion: {{description}}</p>
                    <p>Categoria: {{category}}</p>
                    <p>Precio: $ {{price}}</p>
                    <p hidden="none">IdProducto: {{id}}</p>
                </div>
            </div>
            {{/each}}
        </section>
    </main>
    <footer></footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/index.js"></script>
</div>