{{>navBar}}
{{>message}}
<div>
    <header class="flex-container mb-4 mt-2">
        <div class="col-10 item">
            <h2 class="my-2 mb-3 text-center">Su carrito de compras</h2>
        </div>
        <div class="col-2"> 
            <button type="button" class="btn btn btn-info me-3 my-3"><a class="nav-link"
                    href="/cart/{{ cid  }}/purchase">Finalizar compra</a></button>
        </div>
    </header>
    <main class="flex-container">
        <section class="col-10 flex-container">
            {{#each products}}
                <div class="card my-1 mx-1">
                    <div class="card-body">
                        <h5 class="card-title text-center mb-4">{{title}}</h5>
                        <p>Descripcion: {{description}}</p>
                        <p>Categoria: {{category}}</p>
                        <p>Precio: $ {{price}}</p>
                        <p>Cantidad: {{cantidad}}</p>
                    </div>
                </div>
            {{/each}}
        </section>
    </main>
    <footer></footer>
</div>