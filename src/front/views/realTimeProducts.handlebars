{{>navBar}}
{{>message}}
<div>
    <header class="flex-container">
        <button type="button" class="btn btn-outline-primary mx-3" data-bs-toggle="tooltip" data-bs-placement="right" title="back">
            <a href="/">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-left"
                    viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                        d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                </svg>
            </a>
        </button>
        <div class="col-10 item">
            <h1 class="my-2 mb-3 text-center">Lista de productos actualizada:</h1>
        </div>
    </header>
    <main class="flex-container">
        <section class="col-10 flex-container" id="cardsProducts">
            {{#each products}}
            <div class="card my-1 mx-1">
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">{{title}}</h5>
                    <p>Descripcion: {{description}}</p>
                    <p>Categoria: {{category}}</p>
                    <p>Precio: $ {{price}}</p>
                </div>
            </div>
            {{/each}}
        </section>
    </main>
    <footer></footer>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/index.js"></script>
</div>