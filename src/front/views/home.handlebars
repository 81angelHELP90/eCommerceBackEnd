<div>
    <header class="flex-container">
        <div class="col-10 item">
            <h1 class="my-2 mb-3 text-center">Productos:</h1>
        </div>
        <button type="button" class="btn btn-outline-primary mx-3" data-bs-toggle="tooltip" data-bs-placement="left" title="back">
            <a href="/realtmeproducts">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-chevron-right" viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                        d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" />
                </svg>
            </a>
        </button>
    </header>
    <main class="flex-container">
        <section class="col-10 flex-container">
            {{#each listProducts}}
            <div class="card my-1 mx-1 ">
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">{{title}}</h5>
                    <p>Descripcion: {{description}}</p>
                    <p>Categoria: {{category}}</p>
                    <p>Precio: $ {{price}}</p>
                </div>
            </div>
            {{/each}}
        </section>
    </main>
    <footer></footer>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/index.js"></script>
</div>