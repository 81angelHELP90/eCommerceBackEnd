{{>navBar}}
{{>message}}
<div>
    <header class="flex-container">
        <div class="col-10 item">
            <h1 class="my-2 mb-3 ms-5 text-center">{{ title }}</h1>
        </div>
    </header>
    <main class="flex-container">
        <section class="col-10 flex-container">
            {{#if changePass }}
                <div class="card">
                    <div class="card-body changePassBox">
                        <label for="user">Ingrese correo</label>
                        <input type="text" style="width: 100%" name="user" id="user" placeholder="correo">
                        <label for="password1">Ingrese la nueva contraseña</label>
                        <input type="password1" style="width: 100%" name="password" id="pass1" placeholder="contraseña">
                        <label for="password2">Repita la nueva contraseña</label>
                        <input type="password2" style="width: 100%" name="password" id="pass2" placeholder="contraseña">
                        <input type="text" name="web" value="web" hidden>
                        <p type="text" name="error" value="" id="passError" hidden></p>
                    </div>
                    <div class="card-footer text-center">
                        <button type="button" class="btn btn-primary" onclick="getDataToChangePass()">Restablecer
                            Contraseña</button>
                    </div>
                </div>
            {{else}}
                <form action="/api/sessions/login" method="post">
                    <input type="email" name="email" placeholder="correo electrónico">
                    <input type="password" name="password" placeholder="contraseña">
                    <input type="text" name="web" value="web" hidden>
                    <div class="row my-4">
                        <input type="submit" style="width: 135px" class="my-3 mx-3" value="Ingresar">
                        <a data-bs-toggle="modal" href="#restablecerPassModal" class="my-2">Restablecer contraseña</a>
                    </div>
                </form>
            {{/if}}
            <!-- Modal 1: -->
            <div class="modal fade" id="restablecerPassModal" aria-hidden="true"
                aria-labelledby="restablecerPassModalLabel" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="height: 305px;">
                        <div class="modal-header">
                            <h5 class="modal-title" id="restablecerPassModalLabel">Restablecer contraseña</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body position-relative">
                            <span>Ingrese el correo con el cual se registro:</span>
                            <input type="email" name="email" class="my-3" id="userMail"
                                placeholder="correo electrónico">
                            <p class="my-3">Si el correo existe en nuestro sistema, se le enviará instruccines para
                                restablecer su cuenta.</p>
                            <button type="button" style="width: 135px;" data-bs-dismiss="modal"
                                onclick="sendDataByRecoveryPass()"
                                class="position-absolute bottom-5 start-50 translate-middle-x">Enviar</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Modal 2:  jwtExpired -->
            {{#if jwtExpired }}
                <div class="modal fade show expiredTokenModal" aria-hidden="true" id="expiredTokenModal" aria-labelledby="expiredTokenLabel"
                    tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="height: 205px;">
                            <div class="modal-header">
                                <h5 class="modal-title" id="expiredTokenLabel" style="color:#000000">Link inválido</h5>
                                <button type="button" class="btn-close" id="expiredTokenModalClose" onclick="closeExpiredTokenModal()" data-bs-dismiss="modal2" aria-label="Close"></button>
                            </div>
                            <div class="modal-body position-relative">
                                <p class="my-3" style="color:#000000">
                                    El link para restablecer su contraseña ya no es válido.
                                    Por favor, vuelva a intentarlo desde: Restablecer contraseña
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            {{else}}
                <p hidden>no mostrar nada</p>
            {{/if}}
